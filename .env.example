# Доступ к Telegram API: получить на my.telegram.org -> API development tools
API_ID=
API_HASH=

# Имя файла сессии Telethon (создаётся при первом входе)
SESSION_NAME=activity

# Необязательно: номер телефона и пароль двухфакторной защиты,
# чтобы не вводить их руками при каждом первом запуске
PHONE_NUMBER=
TWO_FACTOR_PASSWORD=
